# 忽略编译产物
*.so
*.qm
!client/res/*.qm
*.ts.autosave
*.o
*.dll
*.exe

# 忽略 uic 生成的界面头文件（应由构建目录重新生成，勿放在源码根目录）
ui_*.h

# 忽略日志和临时文件
log.txt
ts.cmd
*.log
*.tmp

# 忽略文档目录（可选）
doc/*.docx
doc/*.md

# 忽略 IDE / 系统本地文件（不上传远端）
.DS_Store
.qtcreator/
.vscode/
build/
.cursor
ToolingBoardTest_arm64_package/

# 忽略 deb 打包输出（build_deb.sh 生成）
dist/
