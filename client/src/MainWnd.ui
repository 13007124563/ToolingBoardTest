           <layout class="QVBoxLayout" name="verticalLayout_Process">
            <property name="spacing"><number>8</number></property>
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>
            <item>
             <widget class="QLabel" name="lb_process_info">
              <property name="text"><string>Test Execution Process:</string></property>
              <property name="styleSheet"><string>font: 75 12pt "微软雅黑"; color: #333333; background: transparent; border: none;</string></property>
             </widget>
