    <property name="styleSheet">
     <string notr="true">
QPushButton
{
	border: none;
	border-radius:6px;
	font: 16pt &quot;微软雅黑&quot;;
	color:#FFFFFF;
}

/* 橙色按钮 - 镜像版本 */
QPushButton[objectName=&quot;btn_nor_version&quot;]
{
	background-color: #FF8C00;
}
QPushButton[objectName=&quot;btn_nor_version&quot;]:pressed
{
	background-color: #E67E00;
}

/* 蓝色按钮 - IOT测试 */
QPushButton[objectName=&quot;btn_nor_all_test&quot;]
{
	background-color: #005FA7;
}
QPushButton[objectName=&quot;btn_nor_all_test&quot;]:pressed
{
	background-color:#74a8cf;
}

/* 绿色按钮 - 测试记录 */
QPushButton[objectName=&quot;btn_nor_record&quot;]
{
	background-color: #00C853;
}
QPushButton[objectName=&quot;btn_nor_record&quot;]:pressed
{
	background-color: #00A042;
}

/* 白色按钮 - 打开/关闭串口 */
QPushButton[objectName=&quot;btn_nor_open_port&quot;]
{
	background-color: #FFFFFF;
	color: #005FA7;
	border: 2px solid #005FA7;
}
QPushButton[objectName=&quot;btn_nor_open_port&quot;]:pressed
{
	background-color: #E8F2FA;
}

/* 白色按钮 - 清空测试结果 */
QPushButton[objectName=&quot;btn_nor_clear&quot;]
{
	background-color: #FFFFFF;
	color: #FF0000;
	border: 2px solid #FF0000;
}
QPushButton[objectName=&quot;btn_nor_clear&quot;]:pressed
{
	background-color: #FFF0F0;
}

/* 白色按钮 - 发送查询 */
QPushButton[objectName=&quot;btn_query_board_version&quot;]
{
	background-color: #FFFFFF;
	color: #005FA7;
	border: 2px solid #005FA7;
}
QPushButton[objectName=&quot;btn_query_board_version&quot;]:pressed
{
	background-color: #E8F2FA;
}

QPushButton:disabled
{
	background-color:#999999;
	color: #DDDDDD;
	border: none;
}
</string>
    </property>
    <widget class="QWidget" name="page_main">
     <property name="styleSheet">
      <string notr="true">#wnd_left_panel {
    background-color: #ffffff;
    border-radius: 10px;
}
#wnd_right_panel {
    background-color: #ffffff;
    border-radius: 10px;
}

#lb_module_type, #lb_apn_info, #lb_net_info, #lb_serial_port, #lb_baudrate, #lb_board_cmd {
    font: 75 12pt "微软雅黑";
    color: #333333;
}

/* 输入框样式 */
QComboBox, QLineEdit {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 2px;
    background: #FFFFFF;
    font: 12pt "微软雅黑";
    color: #333333;
    min-height: 35px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-left-color: transparent;
    border-left-style: none;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/img/backend/icon-up.png);
    width: 20px;
    height: 13px;
}

/* 模块类型固定 EG21：隐藏下拉箭头 */
#cb_module_type::drop-down {
    width: 0px;
    border: none;
}
#cb_module_type::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}
#cb_module_type {
    padding-right: 8px;
}

/* 右侧信息标签样式（表格式左列） */
#scrollAreaWidgetContents QLabel {
    font: 12pt "微软雅黑";
    color: #666666;
    padding: 0px;
    margin: 0px;
}

/* 右侧信息区只读输入框统一样式（不依赖控件命名） */
#scrollAreaWidgetContents QLineEdit {
     background-color: #F8F8F8;
     border: 1px solid #D5D5D5;
     border-radius: 6px;
     padding: 2px 5px;
     margin: 0px;
     color: #333333;
     font: 12pt "微软雅黑";
}

/* 蓝色信息区滚动条样式 */
#scrollArea_Info,
#scrollArea_Left {
    background: transparent;
    border: none;
}
#scrollAreaWidgetContents,
#scrollAreaWidgetContents_Left {
    background: transparent;
}
#scrollArea_Info QScrollBar:vertical,
#scrollArea_Left QScrollBar:vertical {
    width: 16px;
    margin: 0px;
    background: transparent;
}
#scrollArea_Info QScrollBar::handle:vertical,
#scrollArea_Left QScrollBar::handle:vertical {
    min-height: 20px;
    margin: 0px 2px;
    border-radius: 4px;
    background: #C0C0C0;
}
#scrollArea_Info QScrollBar::add-line:vertical,
#scrollArea_Info QScrollBar::sub-line:vertical,
#scrollArea_Left QScrollBar::add-line:vertical,
#scrollArea_Left QScrollBar::sub-line:vertical {
    height: 0px;
}
#wnd_process_fixed {
    background: transparent;
}</string>
